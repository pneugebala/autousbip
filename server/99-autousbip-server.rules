# /etc/udev/rules.d/99-autousbip-server.rules
#
# Auto-bind/unbind USB devices for USB/IP export on the server side.
#
# The dispatcher script (/usr/local/sbin/autousbip-server) reads
# /etc/autousbip/server.conf and decides whether to act. It schedules the
# actual bind/unbind as transient systemd units so this udev RUN stays
# fast and never blocks event processing.
#
# Match only USB *devices* (not interfaces): device kernel names look like
# "1-2" or "2-1.3" (no colon); interface names look like "1-2:1.0".

SUBSYSTEM=="usb", KERNEL=="[0-9]-*", KERNEL!="*:*", ACTION=="add", \
    RUN+="/usr/local/sbin/autousbip-server udev-add $kernel $attr{idVendor} $attr{idProduct}"

SUBSYSTEM=="usb", KERNEL=="[0-9]-*", KERNEL!="*:*", ACTION=="remove", \
    RUN+="/usr/local/sbin/autousbip-server udev-remove $kernel"
